# ==============================================================================
# MIDDLEWARE RUNTIME CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=development

# Distributed Snowflake ID Generator Node ID Configuration
# Datacenter ID: 0-31 | Worker ID: 0-31
DATACENTER_ID=1
WORKER_ID=1

# ==============================================================================
# PHYSICAL SHARDS CONNECTION PARAMETERS
# ==============================================================================
# SHARD 0 (Default container host port: 3307)
SHARD0_HOST=127.0.0.1
SHARD0_PORT=3307
SHARD0_USER=shard_user
SHARD0_PASSWORD=shard_user_pass
SHARD0_DATABASE=ecommerce_db
SHARD0_POOL_SIZE=20

# SHARD 1 (Default container host port: 3308)
SHARD1_HOST=127.0.0.1
SHARD1_PORT=3308
SHARD1_USER=shard_user
SHARD1_PASSWORD=shard_user_pass
SHARD1_DATABASE=ecommerce_db
SHARD1_POOL_SIZE=20

# SHARD 2 (Default container host port: 3309)
SHARD2_HOST=127.0.0.1
SHARD2_PORT=3309
SHARD2_USER=shard_user
SHARD2_PASSWORD=shard_user_pass
SHARD2_DATABASE=ecommerce_db
SHARD2_POOL_SIZE=20
